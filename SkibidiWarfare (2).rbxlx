<Item class="ServerStorage" referent="RBX00000025"><Properties><string name="Name">ServerStorage</string></Properties></Item>
<Item class="StarterGui" referent="RBX00000026"><Properties><string name="Name">StarterGui</string></Properties></Item>
<Item class="StarterPlayer" referent="RBX00000024"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX00000022"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX00000020"><Properties><string name="Name">MenuClient</string><ProtectedString name="Source"><![CDATA[-- MenuClient (LocalScript, StarterPlayerScripts)
-- Main menu, character select, HUD, input, camera and UI sounds.

local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")
local StarterGui = game:GetService("StarterGui")
local Debris = game:GetService("Debris")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local Config = require(RS:WaitForChild("GameConfig"))
local SND = Config.Sounds
local Remotes = RS:WaitForChild("Remotes")

local SelectCharacter = Remotes:WaitForChild("SelectCharacter")
local RequestMenu = Remotes:WaitForChild("RequestMenu")
local MenuCountdown = Remotes:WaitForChild("MenuCountdown")
local ShowMenu = Remotes:WaitForChild("ShowMenu")
local Spawned = Remotes:WaitForChild("Spawned")
local UseTool = Remotes:WaitForChild("UseTool")
local UseAbility = Remotes:WaitForChild("UseAbility")
local AbilityCooldown = Remotes:WaitForChild("AbilityCooldown")
local Notify = Remotes:WaitForChild("Notify")
local Shake = Remotes:WaitForChild("Shake")
local Launch = Remotes:WaitForChild("Launch")
local ProfileEvent = Remotes:WaitForChild("Profile")
local GetProfile = Remotes:WaitForChild("GetProfile")
local GetCode = Remotes:WaitForChild("GetCode")
local RedeemCode = Remotes:WaitForChild("RedeemCode")
local Previews = RS:WaitForChild("Previews")

local A = CFrame.Angles
local WHITE = Color3.new(1, 1, 1)
local PANEL = Color3.fromRGB(26, 29, 40)
local PANEL2 = Color3.fromRGB(38, 42, 58)
local GREEN = Color3.fromRGB(60, 190, 110)
local RED = Color3.fromRGB(215, 70, 70)
local GOLD = Color3.fromRGB(255, 200, 70)
local MUTED = Color3.fromRGB(160, 168, 190)

local state = "menu" -- "menu" | "select" | "game"
local profile = { kills = 0, unlocked = {} }
local currentDef = nil
local selectedId = nil

----------------------------------------------------------------------
-- Sounds
----------------------------------------------------------------------
local function sfx(id, vol, pitch)
	if not id or id == "" then
		return
	end
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = vol or 0.6
	s.PlaybackSpeed = pitch or 1
	s.Parent = SoundService
	s:Play()
	Debris:AddItem(s, 4)
end

local music = nil
if SND.MenuMusic and SND.MenuMusic ~= "" then
	music = Instance.new("Sound")
	music.SoundId = SND.MenuMusic
	music.Looped = true
	music.Volume = 0.35
	music.Parent = SoundService
end

----------------------------------------------------------------------
-- UI helpers
----------------------------------------------------------------------
local function make(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do
		o[k] = v
	end
	o.Parent = parent
	return o
end

local function corner(parent, r)
	make("UICorner", { CornerRadius = UDim.new(0, r or 8) }, parent)
end

local function text(parent, str, size, pos, textSize, color, align, font)
	return make("TextLabel", {
		BackgroundTransparency = 1,
		Text = str,
		Size = size,
		Position = pos,
		TextSize = textSize or 14,
		TextColor3 = color or WHITE,
		Font = font or Enum.Font.GothamMedium,
		TextXAlignment = align or Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
	}, parent)
end

local function button(parent, str, size, pos, color, onClick, textSize)
	local b = make("TextButton", {
		Text = str,
		Size = size,
		Position = pos,
		BackgroundColor3 = color,
		TextColor3 = WHITE,
		Font = Enum.Font.GothamBold,
		TextSize = textSize or 16,
		AutoButtonColor = true,
	}, parent)
	corner(b, 8)
	b.MouseButton1Click:Connect(function()
		sfx(SND.Click, 0.5)
		onClick()
	end)
	return b
end

local gui = make("ScreenGui", {
	Name = "SkibidiUI",
	ResetOnSpawn = false,
	IgnoreGuiInset = true,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	DisplayOrder = 10,
}, player:WaitForChild("PlayerGui"))

-- every panel is designed at a fixed size and shrunk to fit small phone screens
local scales = {}
local function addScale(parent, w, h, fit, maxScale)
	local s = make("UIScale", {}, parent)
	table.insert(scales, { obj = s, w = w, h = h, fit = fit or 0.92, max = maxScale or 1.1 })
end
local function applyScale()
	local v = camera.ViewportSize
	for _, s in ipairs(scales) do
		s.obj.Scale = math.clamp(math.min(v.X / s.w, v.Y / s.h) * s.fit, 0.45, s.max)
	end
end
camera:GetPropertyChangedSignal("ViewportSize"):Connect(applyScale)

local function panel(w, h, color)
	local f = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.fromOffset(w, h),
		BackgroundColor3 = color or PANEL,
		BorderSizePixel = 0,
		Visible = false,
	}, gui)
	corner(f, 12)
	make("UIStroke", { Color = Color3.fromRGB(70, 78, 110), Thickness = 1.5 }, f)
	addScale(f, w, h)
	return f
end

----------------------------------------------------------------------
-- Toast + countdown banner
----------------------------------------------------------------------
local toast = make("TextLabel", {
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 64),
	Size = UDim2.fromOffset(260, 28),
	BackgroundColor3 = Color3.fromRGB(15, 17, 24),
	BackgroundTransparency = 0.2,
	TextColor3 = WHITE,
	Font = Enum.Font.GothamBold,
	TextSize = 15,
	Text = "",
	Visible = false,
	ZIndex = 20,
}, gui)
corner(toast, 8)
addScale(toast, 700, 380, 0.9, 1)
local toastId = 0
local function showToast(msg)
	toastId = toastId + 1
	local id = toastId
	toast.Text = msg
	toast.Visible = true
	task.delay(2.2, function()
		if toastId == id then
			toast.Visible = false
		end
	end)
end

local banner = make("Frame", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.new(0.5, 0, 0.32, 0),
	Size = UDim2.fromOffset(300, 74),
	BackgroundColor3 = PANEL,
	BackgroundTransparency = 0.05,
	Visible = false,
	ZIndex = 30,
}, gui)
corner(banner, 12)
make("UIStroke", { Color = GOLD, Thickness = 2 }, banner)
addScale(banner, 700, 380, 0.9, 1)
local bannerText = make("TextLabel", {
	BackgroundTransparency = 1,
	Size = UDim2.new(1, 0, 0, 44),
	Position = UDim2.new(0, 0, 0, 4),
	Text = "Returning to menu in 5",
	TextColor3 = WHITE,
	Font = Enum.Font.GothamBold,
	TextSize = 22,
	ZIndex = 31,
}, banner)
local cancelBtn = button(banner, "Cancel", UDim2.fromOffset(90, 22), UDim2.new(0.5, -45, 1, -28), RED, function()
	RequestMenu:FireServer()
end, 13)
cancelBtn.ZIndex = 31

----------------------------------------------------------------------
-- Viewport previews
----------------------------------------------------------------------
local function fillViewport(vp, charId)
	vp:ClearAllChildren()
	local src = Previews:FindFirstChild(charId)
	if not src then
		return nil
	end
	local model = src:Clone()
	model.Parent = vp
	local cf, size = model:GetBoundingBox()
	local cam = Instance.new("Camera")
	cam.FieldOfView = 40
	cam.Parent = vp
	vp.CurrentCamera = cam
	local dist = math.max(size.Y, size.X * 0.9) / (2 * math.tan(math.rad(20))) * 1.12 + size.Z / 2
	cam.CFrame = CFrame.lookAt(cf.Position + Vector3.new(0, size.Y * 0.04, -dist), cf.Position)
	vp.Ambient = Color3.fromRGB(170, 170, 180)
	vp.LightColor = Color3.fromRGB(255, 255, 255)
	vp.LightDirection = Vector3.new(-0.6, -1, 0.7)
	local root = model:FindFirstChild("HumanoidRootPart")
	return model, root and root.Position or cf.Position
end

----------------------------------------------------------------------
-- Main menu
----------------------------------------------------------------------
local mainPanel = panel(300, 340)
text(mainPanel, "SKIBIDI", UDim2.new(1, 0, 0, 44), UDim2.new(0, 0, 0, 16), 40, WHITE, Enum.TextXAlignment.Center, Enum.Font.GothamBlack)
text(mainPanel, "WARFARE", UDim2.new(1, 0, 0, 28), UDim2.new(0, 0, 0, 58), 24, GOLD, Enum.TextXAlignment.Center, Enum.Font.GothamBlack)
text(mainPanel, "Pick a character, fight, unlock more.", UDim2.new(1, -20, 0, 18), UDim2.new(0, 10, 0, 94), 13, MUTED, Enum.TextXAlignment.Center)
local killsLabel = text(mainPanel, "Kills: 0", UDim2.new(1, -20, 0, 18), UDim2.new(0, 10, 0, 114), 14, WHITE, Enum.TextXAlignment.Center, Enum.Font.GothamBold)

-- Save code (no DataStore): copy your code, type it in next time to get your kills back
text(mainPanel, "Save code - keeps your kills", UDim2.new(1, -20, 0, 16), UDim2.new(0, 10, 0, 210), 12, MUTED, Enum.TextXAlignment.Center)
local codeBox = make("TextBox", {
	Position = UDim2.new(0, 10, 0, 230),
	Size = UDim2.fromOffset(190, 32),
	BackgroundColor3 = PANEL2,
	TextColor3 = WHITE,
	PlaceholderText = "XXXXX-XXXXX",
	PlaceholderColor3 = MUTED,
	Text = "",
	ClearTextOnFocus = false,
	Font = Enum.Font.GothamBold,
	TextSize = 16,
}, mainPanel)
corner(codeBox, 8)
local BLUE = Color3.fromRGB(70, 110, 200)
button(mainPanel, "LOAD", UDim2.fromOffset(80, 32), UDim2.new(0, 210, 0, 230), BLUE, function()
	local ok, success, msg = pcall(function()
		return RedeemCode:InvokeServer(codeBox.Text)
	end)
	if ok then
		showToast(msg or (success and "Loaded!" or "Invalid code"))
	else
		showToast("Could not load the code")
	end
end, 14)
button(mainPanel, "SHOW MY SAVE CODE", UDim2.fromOffset(280, 28), UDim2.new(0, 10, 0, 270), BLUE, function()
	local ok, code = pcall(function()
		return GetCode:InvokeServer()
	end)
	if ok and code then
		codeBox.Text = code
		showToast("Copy this code and keep it!")
	else
		showToast("Could not make a code")
	end
end, 13)

----------------------------------------------------------------------
-- Character select
----------------------------------------------------------------------
local selectPanel = panel(640, 330)
text(selectPanel, "Choose your character", UDim2.new(0, 300, 0, 26), UDim2.new(0, 12, 0, 10), 19, WHITE, nil, Enum.Font.GothamBold)

local listFrame = make("ScrollingFrame", {
	Position = UDim2.new(0, 10, 0, 44),
	Size = UDim2.fromOffset(200, 276),
	BackgroundColor3 = PANEL2,
	BorderSizePixel = 0,
	ScrollBarThickness = 4,
	CanvasSize = UDim2.new(0, 0, 0, 0),
	AutomaticCanvasSize = Enum.AutomaticSize.Y,
}, selectPanel)
corner(listFrame, 8)
make("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, listFrame)
make("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6) }, listFrame)

local detail = make("Frame", { Position = UDim2.new(0, 222, 0, 44), Size = UDim2.fromOffset(408, 276), BackgroundTransparency = 1 }, selectPanel)
local bigView = make("ViewportFrame", {
	Size = UDim2.fromOffset(170, 170),
	BackgroundColor3 = Color3.fromRGB(18, 20, 28),
	BorderSizePixel = 0,
}, detail)
corner(bigView, 10)
local nameLabel = text(detail, "", UDim2.fromOffset(228, 26), UDim2.fromOffset(180, 0), 21, WHITE, nil, Enum.Font.GothamBold)
local descLabel = text(detail, "", UDim2.fromOffset(228, 42), UDim2.fromOffset(180, 28), 13, MUTED)
local statsLabel = text(detail, "", UDim2.fromOffset(228, 34), UDim2.fromOffset(180, 74), 13, GOLD, nil, Enum.Font.GothamBold)
local lockLabel = text(detail, "", UDim2.fromOffset(228, 34), UDim2.fromOffset(180, 112), 13, RED, nil, Enum.Font.GothamBold)
local toolLabel = text(detail, "", UDim2.fromOffset(408, 32), UDim2.fromOffset(0, 176), 13, WHITE)
local abilityLabel = text(detail, "", UDim2.fromOffset(408, 32), UDim2.fromOffset(0, 208), 13, WHITE)
local playBtn
local backBtn

local cards = {}
local bigModel, bigCenter = nil, nil
local spinAngle = 0
local spawningLock = false

local function isUnlocked(def)
	return Config.UnlockAll or def.Starter or profile.unlocked[def.Id] == true
end

local function refreshDetail()
	local def = Config.ById[selectedId]
	if not def then
		return
	end
	nameLabel.Text = def.Name
	local note = RS:GetAttribute("Fallback_" .. def.Id) and "  (backup model - the asset could not load)" or ""
	descLabel.Text = def.Desc .. note
	statsLabel.Text = string.format("HP %d    Speed %d    Size %d", def.Health, def.Speed, def.Height)
	toolLabel.Text = "ATTACK  -  " .. def.Tool.Name .. ": " .. def.Tool.Desc
	abilityLabel.Text = "ABILITY (Q)  -  " .. def.Ability.Name .. ": " .. def.Ability.Desc
	local unlocked = isUnlocked(def)
	if unlocked then
		lockLabel.Text = def.Starter and "Starter character" or "Unlocked"
		lockLabel.TextColor3 = GREEN
		playBtn.Text = "PLAY AS " .. string.upper(def.Name)
		playBtn.BackgroundColor3 = GREEN
	else
		lockLabel.Text = "LOCKED - get " .. def.UnlockKills .. " kills (you have " .. profile.kills .. ")"
		lockLabel.TextColor3 = RED
		playBtn.Text = "LOCKED"
		playBtn.BackgroundColor3 = Color3.fromRGB(90, 90, 100)
	end
	for id, c in pairs(cards) do
		c.stroke.Enabled = (id == selectedId)
	end
end

local function loadBigPreview()
	if not selectedId then
		return
	end
	bigModel, bigCenter = fillViewport(bigView, selectedId)
end

local function selectChar(id)
	selectedId = id
	refreshDetail()
	loadBigPreview()
end

local function buildCards()
	for _, c in pairs(cards) do
		c.frame:Destroy()
	end
	cards = {}
	for i, def in ipairs(Config.Characters) do
		local f = make("TextButton", {
			Text = "",
			Size = UDim2.new(1, 0, 0, 62),
			BackgroundColor3 = PANEL,
			LayoutOrder = i,
			AutoButtonColor = true,
		}, listFrame)
		corner(f, 8)
		local stroke = make("UIStroke", { Color = GOLD, Thickness = 2, Enabled = false }, f)
		local vp = make("ViewportFrame", {
			Position = UDim2.fromOffset(5, 5),
			Size = UDim2.fromOffset(52, 52),
			BackgroundColor3 = Color3.fromRGB(18, 20, 28),
			BorderSizePixel = 0,
		}, f)
		corner(vp, 6)
		fillViewport(vp, def.Id)
		text(f, def.Name, UDim2.new(1, -66, 0, 20), UDim2.fromOffset(64, 8), 14, WHITE, nil, Enum.Font.GothamBold)
		local status = text(f, "", UDim2.new(1, -66, 0, 18), UDim2.fromOffset(64, 32), 12, MUTED)
		cards[def.Id] = { frame = f, stroke = stroke, status = status }
		f.MouseButton1Click:Connect(function()
			sfx(SND.Select, 0.5)
			selectChar(def.Id)
		end)
		f.MouseEnter:Connect(function()
			sfx(SND.Hover, 0.15)
		end)
	end
end

local function refreshCards()
	for _, def in ipairs(Config.Characters) do
		local c = cards[def.Id]
		if c then
			if isUnlocked(def) then
				c.status.Text = def.Starter and "Starter" or "Unlocked"
				c.status.TextColor3 = GREEN
			else
				c.status.Text = "LOCKED - " .. def.UnlockKills .. " kills"
				c.status.TextColor3 = RED
			end
		end
	end
	killsLabel.Text = "Kills: " .. profile.kills
	refreshDetail()
end

local function ensureSelectReady()
	if not RS:GetAttribute("TemplatesReady") then
		nameLabel.Text = "Loading characters..."
		descLabel.Text = ""
		RS:GetAttributeChangedSignal("TemplatesReady"):Wait()
	end
	if next(cards) == nil then
		buildCards()
	end
	if not selectedId then
		selectedId = Config.Characters[1].Id
	end
	refreshCards()
	loadBigPreview()
end

playBtn = button(detail, "PLAY", UDim2.fromOffset(408, 34), UDim2.fromOffset(0, 242), GREEN, function()
	local def = Config.ById[selectedId]
	if not def or spawningLock then
		return
	end
	if not isUnlocked(def) then
		showToast(def.Name .. " needs " .. def.UnlockKills .. " kills")
		return
	end
	spawningLock = true
	playBtn.Text = "SPAWNING..."
	SelectCharacter:FireServer(def.Id)
	task.delay(2, function()
		spawningLock = false
		refreshDetail()
	end)
end, 16)

backBtn = button(selectPanel, "< Back", UDim2.fromOffset(78, 26), UDim2.new(1, -90, 0, 9), RED, function()
	-- set below
end, 14)

----------------------------------------------------------------------
-- HUD (menu button, kills, health, ability button)
----------------------------------------------------------------------
local isTouch = UIS.TouchEnabled and not UIS.MouseEnabled

local top = make("Frame", {
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 6),
	Size = UDim2.fromOffset(200, 46),
	BackgroundTransparency = 1,
	Visible = false,
}, gui)
addScale(top, 700, 380, 0.9, 1)

local menuBtn = button(top, "MENU", UDim2.fromOffset(62, 24), UDim2.fromOffset(0, 0), PANEL2, function()
	RequestMenu:FireServer()
end, 13)
local hudKills = text(top, "Kills: 0", UDim2.fromOffset(130, 24), UDim2.fromOffset(70, 3), 14, WHITE, nil, Enum.Font.GothamBold)
hudKills.TextStrokeTransparency = 0.5
local hpBack = make("Frame", {
	Position = UDim2.fromOffset(0, 30),
	Size = UDim2.fromOffset(200, 14),
	BackgroundColor3 = Color3.fromRGB(20, 22, 30),
	BorderSizePixel = 0,
}, top)
corner(hpBack, 7)
local hpFill = make("Frame", { Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = GREEN, BorderSizePixel = 0 }, hpBack)
corner(hpFill, 7)
local hpText = make("TextLabel", {
	BackgroundTransparency = 1,
	Size = UDim2.new(1, 0, 1, 0),
	Text = "",
	TextColor3 = WHITE,
	Font = Enum.Font.GothamBold,
	TextSize = 10,
	ZIndex = 3,
}, hpBack)

local abilityHolder = make("Frame", {
	AnchorPoint = Vector2.new(1, 1),
	Position = isTouch and UDim2.new(1, -96, 1, -150) or UDim2.new(1, -16, 1, -16),
	Size = UDim2.fromOffset(64, 64),
	BackgroundTransparency = 1,
	Visible = false,
}, gui)
addScale(abilityHolder, 700, 380, 0.9, 1)
local abilityBtn = make("TextButton", {
	Size = UDim2.fromOffset(64, 64),
	BackgroundColor3 = PANEL,
	Text = "",
	AutoButtonColor = true,
}, abilityHolder)
corner(abilityBtn, 12)
make("UIStroke", { Color = GOLD, Thickness = 2 }, abilityBtn)
local abilityName = make("TextLabel", {
	BackgroundTransparency = 1,
	Size = UDim2.new(1, -6, 0, 40),
	Position = UDim2.fromOffset(3, 4),
	Text = "",
	TextColor3 = WHITE,
	Font = Enum.Font.GothamBold,
	TextSize = 11,
	TextWrapped = true,
	ZIndex = 2,
}, abilityBtn)
local abilityKey = make("TextLabel", {
	BackgroundTransparency = 1,
	Size = UDim2.new(1, 0, 0, 16),
	Position = UDim2.new(0, 0, 1, -18),
	Text = isTouch and "TAP" or "Q",
	TextColor3 = GOLD,
	Font = Enum.Font.GothamBlack,
	TextSize = 13,
	ZIndex = 2,
}, abilityBtn)
local cooldownOverlay = make("Frame", {
	AnchorPoint = Vector2.new(0, 1),
	Position = UDim2.new(0, 0, 1, 0),
	Size = UDim2.new(1, 0, 0, 0),
	BackgroundColor3 = Color3.new(0, 0, 0),
	BackgroundTransparency = 0.45,
	BorderSizePixel = 0,
	ZIndex = 3,
}, abilityBtn)
corner(cooldownOverlay, 12)

----------------------------------------------------------------------
-- State handling
----------------------------------------------------------------------
local hpConn = nil
local shakeUntil, shakeAmp = 0, 0
local orbit = 0

local function getHumanoid()
	local c = player.Character
	return c and c:FindFirstChildOfClass("Humanoid"), c
end

local function setCoreGui(inGame)
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, inGame)
	end)
end

local function hideBanner()
	banner.Visible = false
end

local function setState(newState)
	state = newState
	mainPanel.Visible = (state == "menu")
	selectPanel.Visible = (state == "select")
	top.Visible = (state == "game")
	abilityHolder.Visible = (state == "game")
	setCoreGui(state == "game")
	if state ~= "game" then
		hideBanner()
		if music then
			music:Play()
		end
		player.CameraMinZoomDistance = 0.5
		player.CameraMaxZoomDistance = 128
		if hpConn then
			hpConn:Disconnect()
			hpConn = nil
		end
	else
		if music then
			music:Stop()
		end
	end
	if state == "select" then
		task.spawn(ensureSelectReady)
	end
end

button(mainPanel, "PLAY", UDim2.fromOffset(220, 48), UDim2.new(0.5, -110, 0, 150), GREEN, function()
	setState("select")
end, 22)
text(mainPanel, "Tip: the MENU button brings you back here.", UDim2.new(1, -20, 0, 30), UDim2.new(0, 10, 1, -40), 12, MUTED, Enum.TextXAlignment.Center)
backBtn.MouseButton1Click:Connect(function()
	setState("menu")
end)

-- abilities ------------------------------------------------------
local cooldownEnd = 0
local function aimPoint()
	local loc
	if isTouch then
		loc = camera.ViewportSize / 2
	else
		loc = UIS:GetMouseLocation()
	end
	local ray = camera:ViewportPointToRay(loc.X, loc.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { player.Character or workspace:FindFirstChild("Effects") or workspace }
	local r = workspace:Raycast(ray.Origin, ray.Direction * 1500, params)
	if r then
		return r.Position
	end
	return ray.Origin + ray.Direction * 600
end

local function useAbility()
	if state ~= "game" or os.clock() < cooldownEnd then
		return
	end
	UseAbility:FireServer(aimPoint())
end
abilityBtn.MouseButton1Click:Connect(useAbility)

AbilityCooldown.OnClientEvent:Connect(function(seconds)
	cooldownEnd = os.clock() + seconds
	cooldownOverlay.Size = UDim2.new(1, 0, 1, 0)
	TweenService:Create(cooldownOverlay, TweenInfo.new(seconds, Enum.EasingStyle.Linear), { Size = UDim2.new(1, 0, 0, 0) }):Play()
end)

UIS.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.KeyCode == Enum.KeyCode.Q then
		useAbility()
	end
end)

-- tools ----------------------------------------------------------
local hooked = {}
local holdId = 0
local function hookTool(tool)
	if hooked[tool] then
		return
	end
	hooked[tool] = true
	tool.Activated:Connect(function()
		holdId = holdId + 1
		local mine = holdId
		UseTool:FireServer(tool.Name, aimPoint(), true)
		if tool:GetAttribute("Hold") then
			task.spawn(function()
				while holdId == mine and tool.Parent == player.Character do
					task.wait(0.1)
					if holdId == mine then
						UseTool:FireServer(tool.Name, aimPoint(), true)
					end
				end
			end)
		end
	end)
	local function stop()
		holdId = holdId + 1
		UseTool:FireServer(tool.Name, nil, false)
	end
	tool.Deactivated:Connect(stop)
	tool.Unequipped:Connect(stop)
end

local function hookCharacter(char)
	for _, c in ipairs(char:GetChildren()) do
		if c:IsA("Tool") then
			hookTool(c)
		end
	end
	char.ChildAdded:Connect(function(c)
		if c:IsA("Tool") then
			hookTool(c)
		end
	end)
end

-- remote events --------------------------------------------------
MenuCountdown.OnClientEvent:Connect(function(n)
	if n and n > 0 then
		banner.Visible = true
		bannerText.Text = "Returning to menu in " .. n
		sfx(SND.Tick, 0.6, 1 + (5 - n) * 0.05)
	else
		hideBanner()
	end
end)


ShowMenu.OnClientEvent:Connect(function(reason)
	setState("menu")
	if reason and reason ~= "" then
		showToast(reason)
	end
end)

Notify.OnClientEvent:Connect(function(msg)
	showToast(msg)
	sfx(SND.Select, 0.5)
end)

Shake.OnClientEvent:Connect(function(amp, secs)
	shakeAmp = amp
	shakeUntil = os.clock() + secs
end)

Launch.OnClientEvent:Connect(function(vel)
	local hum, char = getHumanoid()
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hum and hrp then
		hum:ChangeState(Enum.HumanoidStateType.Freefall)
		hrp:ApplyImpulse(vel * hrp.AssemblyMass)
	end
end)

local function applyProfile(p)
	if type(p) ~= "table" then
		return
	end
	profile = p
	hudKills.Text = "Kills: " .. (p.kills or 0)
	if next(cards) ~= nil then
		refreshCards()
	else
		killsLabel.Text = "Kills: " .. (p.kills or 0)
	end
end
ProfileEvent.OnClientEvent:Connect(applyProfile)

Spawned.OnClientEvent:Connect(function(charId, height)
	currentDef = Config.ById[charId]
	spawningLock = false
	abilityName.Text = currentDef and currentDef.Ability.Name or ""
	cooldownOverlay.Size = UDim2.new(1, 0, 0, 0)
	cooldownEnd = 0

	local hum, char
	local t = 0
	repeat
		hum, char = getHumanoid()
		if hum and char and char:FindFirstChild("HumanoidRootPart") then
			break
		end
		task.wait(0.1)
		t = t + 0.1
	until t > 10
	if not hum then
		return
	end

	setState("game")
	hookCharacter(char)
	camera.CameraType = Enum.CameraType.Custom
	camera.CameraSubject = hum
	local h = height or 6
	player.CameraMinZoomDistance = math.clamp(h * 1.0, 0.5, 100)
	player.CameraMaxZoomDistance = math.clamp(math.max(h * 5, 128), 128, 400)

	if hpConn then
		hpConn:Disconnect()
	end
	local function updateHp()
		local frac = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
		hpFill.Size = UDim2.new(frac, 0, 1, 0)
		hpFill.BackgroundColor3 = frac > 0.5 and GREEN or (frac > 0.25 and GOLD or RED)
		hpText.Text = math.ceil(hum.Health) .. " / " .. math.ceil(hum.MaxHealth)
	end
	hpConn = hum.HealthChanged:Connect(updateHp)
	updateHp()
end)

-- per-frame: menu camera orbit + screen shake + preview spin ------
RunService:BindToRenderStep("SkibidiMenuCamera", Enum.RenderPriority.Camera.Value + 1, function(dt)
	if state ~= "game" then
		orbit = orbit + dt * 0.1
		camera.CameraType = Enum.CameraType.Scriptable
		camera.CFrame = CFrame.lookAt(Vector3.new(math.cos(orbit) * 240, 120, math.sin(orbit) * 240), Vector3.new(0, 45, 0))
	end
	if state == "select" and bigModel and bigModel.Parent and bigCenter then
		spinAngle = spinAngle + dt * 0.9
		bigModel:PivotTo(CFrame.new(bigCenter) * A(0, spinAngle, 0))
	end
	if state == "game" then
		local hum = getHumanoid()
		if hum then
			if os.clock() < shakeUntil then
				local k = shakeAmp * math.clamp((shakeUntil - os.clock()) * 3, 0, 1)
				hum.CameraOffset = Vector3.new((math.random() - 0.5) * k * 2, (math.random() - 0.5) * k * 2, 0)
			elseif hum.CameraOffset.Magnitude > 0 then
				hum.CameraOffset = Vector3.new(0, 0, 0)
			end
		end
	end
end)

-- first launch ------------------------------------------------------
applyScale()
setState("menu")
task.spawn(function()
	local ok, p = pcall(function()
		return GetProfile:InvokeServer()
	end)
	if ok then
		applyProfile(p)
	end
end)
]]></ProtectedString></Properties></Item>
<Item class="LocalScript" referent="RBX00000021"><Properties><string name="Name">CharacterAnimator</string><ProtectedString name="Source"><![CDATA[-- CharacterAnimator (LocalScript, StarterPlayerScripts)
-- Animates every character in the game on this client.
--   * If ReplicatedStorage.Animations.<CharacterId> has Animation objects with an AnimationId,
--     those real animations are played (Idle, Walk, Attack, Ability).
--   * Otherwise the built-in bone animation from CharacterAnim is used.

local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")

local Anim = require(RS:WaitForChild("CharacterAnim"))
local animFolder = RS:WaitForChild("Animations")

local tracked = {}

local function customAnimations(charId)
	local f = animFolder:FindFirstChild(charId)
	if not f then
		return nil
	end
	local found, any = {}, false
	for _, a in ipairs(f:GetChildren()) do
		if a:IsA("Animation") and a.AnimationId ~= "" and a.AnimationId ~= "rbxassetid://0" then
			found[a.Name] = a
			any = true
		end
	end
	return any and found or nil
end

local function setup(model)
	if tracked[model] then
		return
	end
	local state = {}
	tracked[model] = state

	local charId = model:GetAttribute("CharId")
	if not charId then
		model:GetAttributeChangedSignal("CharId"):Wait()
		charId = model:GetAttribute("CharId")
	end

	local custom = customAnimations(charId)
	if custom then
		local hum = model:WaitForChild("Humanoid", 5)
		local animator = hum and (hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 5))
		if animator then
			state.tracks = {}
			for name, anim in pairs(custom) do
				local ok, track = pcall(function()
					return animator:LoadAnimation(anim)
				end)
				if ok and track then
					state.tracks[name] = track
				end
			end
			if state.tracks.Idle then
				state.tracks.Idle.Looped = true
				state.tracks.Idle.Priority = Enum.AnimationPriority.Idle
			end
			if state.tracks.Walk then
				state.tracks.Walk.Looped = true
				state.tracks.Walk.Priority = Enum.AnimationPriority.Movement
			end
			for _, n in ipairs({ "Attack", "Ability" }) do
				if state.tracks[n] then
					state.tracks[n].Priority = Enum.AnimationPriority.Action
				end
			end
			state.custom = true
			model:GetAttributeChangedSignal("AtkTime"):Connect(function()
				if state.tracks.Attack then
					state.tracks.Attack:Play(0.05)
				end
			end)
			model:GetAttributeChangedSignal("AbTime"):Connect(function()
				if state.tracks.Ability then
					state.tracks.Ability:Play(0.05)
				end
			end)
		end
	end
end

CollectionService:GetInstanceAddedSignal("SkibidiChar"):Connect(function(model)
	task.spawn(setup, model)
end)
for _, m in ipairs(CollectionService:GetTagged("SkibidiChar")) do
	task.spawn(setup, m)
end

RunService.RenderStepped:Connect(function(dt)
	for model, state in pairs(tracked) do
		if not model.Parent then
			tracked[model] = nil
		elseif state.custom then
			local hrp = model:FindFirstChild("HumanoidRootPart")
			if hrp then
				local v = hrp.AssemblyLinearVelocity
				local moving = Vector3.new(v.X, 0, v.Z).Magnitude > 1.5
				local walk, idle = state.tracks.Walk, state.tracks.Idle
				if moving then
					if idle and idle.IsPlaying then
						idle:Stop(0.15)
					end
					if walk and not walk.IsPlaying then
						walk:Play(0.15)
					end
				else
					if walk and walk.IsPlaying then
						walk:Stop(0.15)
					end
					if idle and not idle.IsPlaying then
						idle:Play(0.15)
					end
				end
			end
		elseif model:GetAttribute("CharId") then
			Anim.Step(model, state, dt)
		end
	end
end)
]]></ProtectedString></Properties></Item>
</Item>
<Item class="StarterCharacterScripts" referent="RBX00000023"><Properties><string name="Name">StarterCharacterScripts</string></Properties></Item>
