<Item class="ReplicatedStorage" referent="RBX0000001D"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="ModuleScript" referent="RBX0000001A"><Properties><string name="Name">GameConfig</string><ProtectedString name="Source"><![CDATA[-- GameConfig (ModuleScript, ReplicatedStorage)
-- Everything you might want to tweak lives here.

local Config = {}

-- Set to true to unlock every character right away (handy for testing).
Config.UnlockAll = false

Config.MenuReturnSeconds = 5      -- "Returning to menu in 5"
Config.RespawnToMenuDelay = 3     -- seconds after dying before you go back to the menu
Config.MaxNpcs = 6                -- training "Agents" you can kill for kills/unlocks

-- Sounds. These are built-in Roblox sounds so they always load.
-- Swap any of them for your own like "rbxassetid://123456789".
Config.Sounds = {
	Click = "rbxasset://sounds/button.wav",
	Hover = "rbxasset://sounds/clickfast.wav",
	Select = "rbxasset://sounds/electronicpingshort.wav",
	Tick = "rbxasset://sounds/switch.wav",
	Spawn = "rbxasset://sounds/flashbulb.wav",
	Punch = "rbxasset://sounds/swordslash.wav",
	Bonk = "rbxasset://sounds/kerplunk.wav",
	Hit = "rbxasset://sounds/snap.mp3",
	Blaster = "rbxasset://sounds/Rocket shot.wav",
	LaserLoop = "rbxasset://sounds/Launching rocket.wav",
	Scream = "rbxasset://sounds/uuhhh.mp3",
	Slam = "rbxasset://sounds/impact_explosion_03.mp3",
	Leap = "rbxasset://sounds/kerplunk.wav",
	Stomp = "rbxasset://sounds/bomb.wav",
	Death = "rbxasset://sounds/uuhhh.mp3",
	Unlock = "rbxasset://sounds/victory.wav",
	MenuMusic = "", -- optional: put a rbxassetid:// music id here
}

-- Characters.
--  AssetId   : the Roblox asset id of the model (loaded with InsertService at runtime)
--  Height    : final height in studs (every model is auto-scaled to this)
--  ModelYaw  : rotate the model if it faces the wrong way (0, 90, 180, -90)
--  Roles     : which body parts to make animatable (matched by part name)
Config.Characters = {
	{
		Id = "skibidi", Name = "Skibidi Toilet", AssetId = 17759547081,
		Starter = true, UnlockKills = 0,
		Height = 5, Health = 120, Speed = 20, Jump = 55, ModelYaw = 0,
		Desc = "The classic. Bounces around, sings and bonks.",
		Tool = { Name = "Head Bonk", Desc = "Headbutt everything in front of you.", Hold = true },
		Ability = { Name = "Skibidi Scream", Desc = "Shockwave that damages and stuns nearby enemies.", Cooldown = 9 },
		Roles = { "head" },
	},
	{
		Id = "cameraman", Name = "Camera Man", AssetId = 15398069016,
		Starter = true, UnlockKills = 0,
		Height = 6, Health = 160, Speed = 22, Jump = 55, ModelYaw = 0,
		Desc = "Fast and tough. Three-hit punch combo.",
		Tool = { Name = "Punch", Desc = "3-hit punch combo. Hold to keep punching.", Hold = true },
		Ability = { Name = "Ground Slam", Desc = "Jump and smash the ground, damaging and stunning enemies.", Cooldown = 8 },
		Roles = { "head", "armL", "armR", "legL", "legR" },
	},
	{
		Id = "strider", Name = "Strider Skibidi", AssetId = 17760752561,
		Starter = false, UnlockKills = 10,
		Height = 14, Health = 320, Speed = 26, Jump = 70, ModelYaw = 0,
		Desc = "Walks on spider legs and shoots a blaster.",
		Tool = { Name = "Blaster", Desc = "Rapid fire energy blaster. Hold to keep firing.", Hold = true },
		Ability = { Name = "Spider Leap", Desc = "Leap through the air and crash down on enemies.", Cooldown = 7 },
		Roles = { "head", "legs" },
		Muzzle = { Y = 0.72, Sep = 0.22, Z = 0.20 }, -- where the blaster shots come out
	},
	{
		Id = "gbathtub", Name = "G-Bathtub", AssetId = 16314159987,
		Starter = false, UnlockKills = 30,
		Height = 34, Health = 1500, Speed = 34, Jump = 50, ModelYaw = 0,
		Desc = "The biggest of them all. Fires lasers from its eyes.",
		Tool = { Name = "Eye Lasers", Desc = "Hold to fire lasers from both eyes.", Hold = true },
		Ability = { Name = "Titan Stomp", Desc = "A huge quake that hurts everything around you.", Cooldown = 12 },
		Roles = { "head" },
		Eye = { Y = 0.86, Sep = 0.05, Z = 0.10 }, -- where the laser eyes sit (fractions of Height)
	},
}

Config.ById = {}
for _, def in ipairs(Config.Characters) do
	Config.ById[def.Id] = def
end

return Config
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000001B"><Properties><string name="Name">CharacterAnim</string><ProtectedString name="Source"><![CDATA[-- CharacterAnim (ModuleScript, ReplicatedStorage)
-- Code-driven "bone" animation for every character (idle / walk / attack / ability).
-- It moves the Motor6D joints that the server tagged with the attribute "AnimRole".
-- If you put real AnimationIds into ReplicatedStorage.Animations.<CharacterId>, those
-- are used instead (see the CharacterAnimator LocalScript).

local Anim = {}

local A = CFrame.Angles
local sin, cos, abs, clamp = math.sin, math.cos, math.abs, math.clamp

local function collect(model, state)
	state.roles = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Motor6D") then
			local role = d:GetAttribute("AnimRole")
			if role then
				local list = state.roles[role]
				if not list then
					list = {}
					state.roles[role] = list
				end
				table.insert(list, d)
			end
		end
	end
end

local function setAll(list, cf)
	if list then
		for _, m in ipairs(list) do
			m.Transform = cf
		end
	end
end

local function headCF(id, t, mv, laser, H)
	if id == "skibidi" then
		local f = 5 + mv * 3
		return CFrame.new(0, abs(sin(t * f * 1.4)) * H * 0.015, 0)
			* A(sin(t * f * 1.4) * 0.14, 0, sin(t * f * 0.7) * 0.30)
	elseif id == "gbathtub" then
		local j = laser and 1 or 0
		return A(
			sin(t * 1.1) * 0.07 + (math.random() - 0.5) * 0.06 * j,
			sin(t * 0.7) * 0.35,
			sin(t * 1.6) * 0.06 + (math.random() - 0.5) * 0.06 * j
		)
	elseif id == "strider" then
		return A(sin(t * 1.9) * 0.06, sin(t * 0.9) * 0.5, 0)
	end
	return A(sin(t * 1.5) * 0.04, sin(t * 0.8) * 0.12, 0)
end

-- model : the character model (server tags it with CharId + Height attributes)
-- state : a table you keep for that model between calls
-- opts  : optional { speed = number, since = number } to force values (used for previews)
function Anim.Step(model, state, dt, opts)
	opts = opts or {}
	if not state.roles then
		collect(model, state)
	end
	local roles = state.roles

	local id = model:GetAttribute("CharId") or ""
	local H = model:GetAttribute("Height") or 6
	local hrp = model:FindFirstChild("HumanoidRootPart")

	local speed = opts.speed
	if speed == nil then
		speed = 0
		if hrp then
			local v = hrp.AssemblyLinearVelocity
			speed = Vector3.new(v.X, 0, v.Z).Magnitude
		end
	end

	local target = clamp(speed / 14, 0, 1.4)
	state.mv = (state.mv or 0) + (target - (state.mv or 0)) * (1 - math.exp(-dt * 10))
	local mv = state.mv
	state.t = (state.t or 0) + dt
	local t = state.t
	local freq = (3 + speed * 0.22) * (6 / math.max(H, 3)) ^ 0.3
	state.phase = (state.phase or 0) + dt * freq * (mv > 0.05 and 1 or 0.2)
	local phase = state.phase

	local atkName = model:GetAttribute("AtkName")
	local atkTime = model:GetAttribute("AtkTime")
	local since = opts.since or (atkTime and (workspace:GetServerTimeNow() - atkTime)) or 99
	local idx = model:GetAttribute("AtkIdx") or 1
	local abTime = model:GetAttribute("AbTime")
	local abSince = opts.abSince or (abTime and (workspace:GetServerTimeNow() - abTime)) or 99
	local laser = model:GetAttribute("Laser") == true

	-- body: bob, lean and sway
	local bob = sin(phase * 2) * H * 0.012 * mv + sin(t * 1.6) * H * 0.005
	local sway = sin(phase) * 0.05 * mv
	local lean = -0.08 * mv
	local punch = 0
	if atkName == "Punch" and since < 0.4 then
		punch = sin(clamp(since / 0.4, 0, 1) * math.pi)
		lean = lean + 0.25 * punch
	end
	if atkName == "Bonk" and since < 0.35 then
		lean = lean + 0.45 * sin(clamp(since / 0.35, 0, 1) * math.pi)
	end
	if atkName == "Blast" and since < 0.15 then
		lean = lean - 0.06 * (1 - since / 0.15)
	end
	local squash = 0
	if abSince < 0.5 then
		squash = sin(clamp(abSince / 0.5, 0, 1) * math.pi)
	end
	setAll(roles.body, CFrame.new(0, bob - H * 0.03 * squash, 0) * A(lean + 0.12 * squash, 0, sway))

	-- head
	setAll(roles.head, headCF(id, t, mv, laser, H))

	-- arms
	local swing = sin(phase) * 0.9 * mv
	local rightArm = -swing
	local leftArm = swing
	if punch > 0 then
		if idx % 2 == 1 then
			rightArm = 1.7 * punch
		else
			leftArm = 1.7 * punch
		end
	end
	setAll(roles.armR, A(rightArm, 0, 0.05))
	setAll(roles.armL, A(leftArm, 0, -0.05))

	-- humanoid legs
	local legSwing = sin(phase) * 0.8 * mv
	setAll(roles.legR, A(legSwing, 0, 0))
	setAll(roles.legL, A(-legSwing, 0, 0))

	-- spider legs (thigh = legA, shin = legB)
	if roles.legA then
		for _, m in ipairs(roles.legA) do
			local i = m:GetAttribute("LegIndex") or 1
			local p = phase + (i % 2) * math.pi + i * 0.35
			local lift = math.max(0, sin(p)) * 0.55 * mv
			local fwd = cos(p) * 0.28 * mv
			local idle = sin(t * 1.4 + i) * 0.03
			m.Transform = A(lift + idle, fwd, 0)
		end
	end
	if roles.legB then
		for _, m in ipairs(roles.legB) do
			local i = m:GetAttribute("LegIndex") or 1
			local p = phase + (i % 2) * math.pi + i * 0.35
			m.Transform = A(-math.max(0, sin(p)) * 0.45 * mv, 0, 0)
		end
	end
end

return Anim
]]></ProtectedString></Properties></Item>
<Item class="Folder" referent="RBX0000001C"><Properties><string name="Name">Animations</string></Properties><Item class="StringValue" referent="RBX00000015"><Properties><string name="Name">HOW_TO_ANIMATE</string><string name="Value">HOW TO USE YOUR OWN ANIMATIONS

1. Animate the character's rig in the Animation Editor (or any rig tool) and publish each animation.
2. Paste the animation id into the AnimationId of the matching Animation here, e.g. rbxassetid://123456789
   Animations: Idle, Walk, Attack, Ability
3. Folder names match the character ids: skibidi, cameraman, strider, gbathtub.
4. As soon as ANY animation in a character's folder has an id, the built-in code animation is turned off for that
   character and your animations play instead (Idle when standing, Walk when moving, Attack when using the main
   weapon, Ability when pressing Q).
5. The joints (Motor6D) of the loaded model are left untouched, so your animation must use the model's own joint names.</string></Properties></Item>
